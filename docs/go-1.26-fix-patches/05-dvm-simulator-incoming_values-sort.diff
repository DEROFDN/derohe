+       for k := range incoming_values {
+               assets = append(assets, k)
+       }
+       sort.Slice(assets, func(i, j int) bool {
+               return bytes.Compare(assets[i][:], assets[j][:]) < 0
+       })
+       for _, scid_asset := range assets {
+               burnvalue := incoming_values[scid_asset]
